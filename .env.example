# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Session (required in production — min 16 chars, strong random)
SESSION_SECRET=change_me_to_a_long_random_secret
SESSION_COOKIE_NAME=mlf.sid
SESSION_MAX_AGE_MS=604800000

# PostgreSQL (required for auth and sessions)
DATABASE_URL=postgresql://postgres:password@localhost:5432/maps_leads_finder

SESSION_TABLE=session

# Trusted proxy hops for req.ip (0 = ignore X-Forwarded-For).
# Development: leave 0. Production: set only after confirming how many trusted
# reverse proxies sit in front of the app (host docs / network). Do not assume 1.
TRUST_PROXY_HOPS=0

# Email (optional in development — messages are logged if SMTP is unset)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=noreply@example.com
