NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=dev-only-change-me-not-for-production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maps_leads_finder
TRUST_PROXY_HOPS=0

# Email (Brevo Transactional API — HTTPS, not SMTP)
# BREVO_API_KEY=
# MAIL_FROM=verified-sender@yourdomain.com
# MAIL_FROM_NAME=Maps Leads Finder

# Search providers (server only — never expose to frontend)
# Apify — recommended actor: compass/crawler-google-places
# APIFY_TOKEN=
# APIFY_ACTOR_ID=compass~crawler-google-places
# Optional: override default Compass input template
# APIFY_INPUT_JSON={"searchStringsArray":["{{query}}"],"locationQuery":"{{location}}","maxCrawledPlacesPerSearch":{{limit}}}
# APIFY_LANGUAGE=pt
# APIFY_MAX_WAIT_MS=180000

# TOMTOM_API_KEY=
# FOURSQUARE_API_KEY=
# FOURSQUARE_API_VERSION=2025-06-17

# Abandoned search recovery (recommended on Render)
# ENABLE_ABANDONED_SEARCH_RECOVERY=1
