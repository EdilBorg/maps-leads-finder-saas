NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=dev-only-change-me-not-for-production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maps_leads_finder
TRUST_PROXY_HOPS=0

# Email (Brevo Transactional API — HTTPS, not SMTP)
# Required in production. Never commit real values.
# BREVO_API_KEY=
# MAIL_FROM=verified-sender@yourdomain.com
# MAIL_FROM_NAME=Maps Leads Finder

# Search providers (server only)
# GOOGLE_MAPS_API_KEY=
# APIFY_TOKEN=
# APIFY_ACTOR_ID=
# Optional actor input mapping (actors differ):
# APIFY_INPUT_JSON={"search":"{{query}}","location":"{{location}}","maxItems":{{limit}}}
# APIFY_INPUT_QUERY_KEY=search
# APIFY_INPUT_LOCATION_KEY=location
# APIFY_INPUT_LIMIT_KEY=maxItems
# OSM_USER_AGENT=MapsLeadsFinderSaaS/0.1 (contact@example.com)
# OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSM_SEARCH_RADIUS_M=5000
# OSM_DISABLED=0
