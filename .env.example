# =============================================================================
# Maps Leads Finder SaaS — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file.
# =============================================================================

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Session (generate a long random string for production)
SESSION_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# PostgreSQL
# Example: postgresql://user:password@localhost:5432/maps_leads_finder
DATABASE_URL=postgresql://postgres:password@localhost:5432/maps_leads_finder

# Optional explicit connection settings (used if DATABASE_URL is not set)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=password
# PGDATABASE=maps_leads_finder

# Session store table name (connect-pg-simple)
# SESSION_TABLE=session

# Future: API providers (keys stay on the server only)
# OUTSCRAPER_API_KEY=
# APIFY_API_TOKEN=
# OTHER_PROVIDER_API_KEY=

# Future: Payment gateway
# PAYMENT_GATEWAY_SECRET=
# PAYMENT_WEBHOOK_SECRET=
